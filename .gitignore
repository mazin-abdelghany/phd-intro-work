**/.DS_Store
/groupSequentialDesigns/.Rproj.user

# ignore all LaTeX output files except .tex, .pdf, and .bib
/derivations/**/*.aux
/derivations/**/*.bbl
/derivations/**/*.bcf
/derivations/**/*.blg
/derivations/**/*.log
/derivations/**/*.out
/derivations/**/*.run.xml
/derivations/**/*.synctex.gz
/derivations/**/*-blx.bib
/derivations/**/*.toc

# ignore all Jupyter notebook checkpoints
**/.ipynb_checkpoints

# ignore the build directory of the python library
/pyGroupSequentialDesigns/build/*

# ignore the NVIDIA shader cache files
.nv_cache/

# ignore large data files
/experiments_rand_simann_bo/**/*10x230k.csv
